{% extends "layouts/main.html.twig" %}

{% block title %}Iniciar Nueva Renta{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold"><i class="bi bi-play-circle me-2 text-primary"></i>Iniciar Sesión de Renta</h5>
          <a href="{{ base_url }}/rents" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver
          </a>
        </div>
        <div class="card-body">
          {% if errors is defined and errors is not empty %}
            <div class="alert alert-danger">
              <ul class="mb-0">
                {% for err in errors %}
                  <li>{{ err }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <form method="POST" action="{{ base_url }}/rents/create">
            {{ csrf_field() }}

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-bold">Equipo / Cabina *</label>
                <select name="equipment_id" class="form-select" required>
                  <option value="">-- Seleccionar Equipo Disponible --</option>
                  {% for eq in equipments %}
                    <option value="{{ eq.id }}" {{ selected_equipment == eq.id ? 'selected' : '' }}>
                      {{ eq.name }} ({{ eq.code ?: 'Sin código' }}) - ${{ eq.price_hour }}/hr
                    </option>
                  {% endfor %}
                </select>
                {% if equipments is empty %}
                  <small class="text-danger d-block mt-1">No hay equipos libres en este momento.</small>
                {% endif %}
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold">Nombre del Cliente *</label>
                <input type="text" name="person_name" class="form-control" required placeholder="Ej: Juan Pérez" value="{{ old.person_name|default('Público General') }}">
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold">Fecha de Inicio *</label>
                <input type="date" name="start_date" class="form-control" required value="{{ current_date }}">
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold">Hora de Inicio *</label>
                <input type="time" name="start_time" class="form-control" required value="{{ current_time }}">
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold">Minutos de Bono</label>
                <input type="number" name="bonus_mins" class="form-control" min="0" value="0">
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold">Monto Inicial o Prepago ($)</label>
                <input type="number" step="0.5" name="price" class="form-control" value="0.00">
                <small class="text-muted">Si el cliente prepaga un tiempo, o dejar en 0 para liquidar al salir.</small>
              </div>

              <div class="col-12 text-end mt-4">
                <a href="{{ base_url }}/rents" class="btn btn-secondary me-2">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4" {{ equipments is empty ? 'disabled' : '' }}>
                  <i class="bi bi-play-circle me-1"></i> Iniciar Renta
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
