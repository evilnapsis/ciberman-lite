{% extends "layouts/main.html.twig" %}

{% block title %}Editar Renta{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold"><i class="bi bi-pencil me-2"></i>Editar Renta #{{ rent.id }}</h5>
          <a href="{{ base_url }}/rents" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver
          </a>
        </div>
        <div class="card-body">
          <form method="POST" action="{{ base_url }}/rents/update/{{ rent.id }}">
            {{ csrf_field() }}

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-bold">Equipo *</label>
                <select name="equipment_id" class="form-select" required>
                  {% for eq in equipments %}
                    <option value="{{ eq.id }}" {{ rent.equipment_id == eq.id ? 'selected' : '' }}>
                      {{ eq.name }} ({{ eq.code ?: 'Sin código' }})
                    </option>
                  {% endfor %}
                </select>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold">Cliente *</label>
                <input type="text" name="person_name" class="form-control" required value="{{ rent.person_name }}">
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold">Fecha de Inicio *</label>
                <input type="date" name="start_date" class="form-control" required value="{{ rent.start_date }}">
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold">Hora de Inicio *</label>
                <input type="time" name="start_time" class="form-control" required value="{{ rent.start_time }}">
              </div>

              <div class="col-md-4">
                <label class="form-label fw-bold">Minutos de Bono</label>
                <input type="number" name="bonus_mins" class="form-control" min="0" value="{{ rent.bonus_mins }}">
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold">Hora de Fin</label>
                <input type="time" name="finish_time" class="form-control" value="{{ rent.finish_time }}">
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold">Total Cobrado ($)</label>
                <input type="number" step="0.5" name="price" class="form-control" value="{{ rent.price }}">
              </div>

              <div class="col-12 text-end mt-4">
                <a href="{{ base_url }}/rents" class="btn btn-secondary me-2">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4">
                  <i class="bi bi-save me-1"></i> Guardar Cambios
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
