{% extends "layouts/main.html.twig" %}

{% block title %}Rentas de Tiempo{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Historial y Control de Rentas</h2>
      <p class="text-muted mb-0">Listado de sesiones de alquiler por fecha y cobranzas.</p>
    </div>
    <div class="d-flex gap-2">
      <form method="GET" action="{{ base_url }}/rents" class="d-flex gap-2 align-items-center">
        <input type="date" name="date_at" class="form-control" value="{{ current_date }}">
        <button type="submit" class="btn btn-outline-primary">
          <i class="bi bi-filter"></i> Filtrar
        </button>
      </form>
      <a href="{{ base_url }}/rents/new" class="btn btn-primary text-nowrap">
        <i class="bi bi-plus-lg me-1"></i> Nueva Renta
      </a>
    </div>
  </div>

  <div class="row mb-4">
    <div class="col-md-4">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body">
          <div class="small text-muted text-uppercase fw-bold">Fecha Consultada</div>
          <div class="fs-5 fw-bold text-dark">{{ current_date }}</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body">
          <div class="small text-muted text-uppercase fw-bold">Total de Sesiones</div>
          <div class="fs-5 fw-bold text-dark">{{ rents|length }}</div>
        </div>
      </div>
    </div>
    <div class="col-md-4">
      <div class="card border-0 shadow-sm bg-light">
        <div class="card-body">
          <div class="small text-muted text-uppercase fw-bold">Total Recaudado</div>
          <div class="fs-5 fw-bold text-success">${{ total_day|number_format(2, '.', ',') }}</div>
        </div>
      </div>
    </div>
  </div>

  <div class="card shadow-sm">
    <div class="card-body">
      {% if rents is empty %}
        <div class="text-center py-5 text-muted">
          <i class="bi bi-clock-history fs-1 d-block mb-3"></i>
          <h5>No hay rentas registradas para la fecha seleccionada</h5>
          <p>Puedes iniciar una nueva sesión de alquiler o elegir otra fecha.</p>
          <a href="{{ base_url }}/rents/new" class="btn btn-primary mt-2">Iniciar Renta</a>
        </div>
      {% else %}
        <div class="table-responsive">
          <table class="table table-sm table-hover align-middle">
            <thead class="table-light">
              <tr>
                <th>ID</th>
                <th>Cliente</th>
                <th>Equipo</th>
                <th>Fecha</th>
                <th>Inicio</th>
                <th>Fin</th>
                <th>Bono</th>
                <th>Total Cobrado</th>
                <th>Estado</th>
                <th class="text-end">Acciones</th>
              </tr>
            </thead>
            <tbody>
              {% for r in rents %}
                <tr>
                  <td>#{{ r.id }}</td>
                  <td class="fw-bold">{{ r.person_name }}</td>
                  <td>{{ r.equipment ? r.equipment.name : 'Equipo #' ~ r.equipment_id }}</td>
                  <td>{{ r.start_date }}</td>
                  <td><span class="badge bg-light text-dark border">{{ r.start_time }}</span></td>
                  <td>
                    {% if r.finish_time %}
                      <span class="badge bg-light text-dark border">{{ r.finish_time }}</span>
                    {% else %}
                      <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>En curso</span>
                    {% endif %}
                  </td>
                  <td>{{ r.bonus_mins }} min</td>
                  <td class="fw-bold text-success">
                    ${{ r.price|number_format(2, '.', ',') }}
                  </td>
                  <td>
                    {% if r.is_active %}
                      <span class="badge bg-danger">Activa</span>
                    {% else %}
                      <span class="badge bg-success">Completada</span>
                    {% endif %}
                  </td>
                  <td class="text-end">
                    {% if r.is_active %}
                      <a href="{{ base_url }}/rents/finish/{{ r.id }}" class="btn btn-xs btn-danger me-1" title="Finalizar y Cobrar">
                        <i class="bi bi-cash"></i> Cobrar
                      </a>
                    {% endif %}
                    <a href="{{ base_url }}/rents/edit/{{ r.id }}" class="btn btn-xs btn-warning me-1" title="Editar">
                      <i class="bi bi-pencil"></i>
                    </a>
                    <a href="{{ base_url }}/rents/delete/{{ r.id }}" class="btn btn-xs btn-danger" onclick="return confirm('¿Seguro que deseas eliminar este registro de renta?');" title="Eliminar">
                      <i class="bi bi-trash"></i>
                    </a>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% endblock %}
