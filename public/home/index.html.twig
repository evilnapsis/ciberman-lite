{% extends "layouts/main.html.twig" %}

{% block title %}Dashboard{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <h2 class="h3 mb-0 text-gray-800">Panel de Control - Ciber Café</h2>
      <p class="text-muted mb-0">Monitoreo en tiempo real de cabinas, uso y recaudación.</p>
    </div>
    <div>
      <a href="{{ base_url }}/rents/new" class="btn btn-primary">
        <i class="bi bi-play-circle me-1"></i> Iniciar Renta
      </a>
    </div>
  </div>

  <!-- Tarjetas de métricas -->
  <div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
      <div class="card text-white bg-primary shadow-sm border-0">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="text-white-50 small text-uppercase fw-bold">Equipos Totales</div>
              <div class="fs-3 fw-bold">{{ total_equipments }}</div>
            </div>
            <i class="bi bi-display fs-1 text-white-50"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card text-white bg-success shadow-sm border-0">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="text-white-50 small text-uppercase fw-bold">Disponibles</div>
              <div class="fs-3 fw-bold">{{ available_count }}</div>
            </div>
            <i class="bi bi-check-circle fs-1 text-white-50"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card text-white bg-danger shadow-sm border-0">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="text-white-50 small text-uppercase fw-bold">En Uso</div>
              <div class="fs-3 fw-bold">{{ occupied_count }}</div>
            </div>
            <i class="bi bi-hourglass-split fs-1 text-white-50"></i>
          </div>
        </div>
      </div>
    </div>

    <div class="col-sm-6 col-xl-3">
      <div class="card text-white bg-info shadow-sm border-0">
        <div class="card-body">
          <div class="d-flex justify-content-between align-items-start">
            <div>
              <div class="text-white-50 small text-uppercase fw-bold">Ingresos Hoy</div>
              <div class="fs-3 fw-bold">${{ income_today|number_format(2, '.', ',') }}</div>
            </div>
            <i class="bi bi-cash-coin fs-1 text-white-50"></i>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Estado visual de cabinas / computadoras -->
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3">
      <h5 class="mb-0 fw-bold"><i class="bi bi-grid-3x3-gap me-2"></i>Monitoreo Visual de Cabinas</h5>
    </div>
    <div class="card-body">
      {% if equipments is empty %}
        <div class="text-center py-4 text-muted">
          <i class="bi bi-info-circle fs-2 d-block mb-2"></i>
          No hay equipos registrados todavía. <a href="{{ base_url }}/equipments/new">Registrar primer equipo</a>.
        </div>
      {% else %}
        <div class="row g-3">
          {% for eq in equipments %}
            <div class="col-sm-6 col-md-4 col-lg-3">
              <div class="card h-100 border-2 {{ eq.is_occupied ? 'border-danger' : 'border-success' }}">
                <div class="card-body text-center">
                  <div class="mb-2">
                    <i class="bi bi-pc-display {{ eq.is_occupied ? 'text-danger' : 'text-success' }}" style="font-size: 2.5rem;"></i>
                  </div>
                  <h6 class="fw-bold mb-1">{{ eq.name }}</h6>
                  <span class="badge {{ eq.is_occupied ? 'bg-danger' : 'bg-success' }} mb-2">
                    {{ eq.is_occupied ? 'OCUPADO' : 'DISPONIBLE' }}
                  </span>
                  <div class="small text-muted mb-2">
                    Código: {{ eq.code ?: 'N/A' }}<br>
                    Tarifa: ${{ eq.price_hour }}/hr
                  </div>
                  {% if eq.is_occupied and eq.current_rent %}
                    <div class="alert alert-light border py-1 px-2 small mb-2 text-start">
                      <strong>Cliente:</strong> {{ eq.current_rent.person_name }}<br>
                      <strong>Inicio:</strong> {{ eq.current_rent.start_time }}
                    </div>
                    <a href="{{ base_url }}/rents/finish/{{ eq.current_rent.id }}" class="btn btn-sm btn-outline-danger w-100">
                      <i class="bi bi-stop-circle me-1"></i> Cobrar / Finalizar
                    </a>
                  {% else %}
                    <a href="{{ base_url }}/rents/new?equipment_id={{ eq.id }}" class="btn btn-sm btn-outline-success w-100">
                      <i class="bi bi-play-circle me-1"></i> Asignar Renta
                    </a>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>

  <!-- Rentas activas en curso -->
  {% if active_rents is not empty %}
  <div class="card shadow-sm mb-4">
    <div class="card-header bg-white py-3">
      <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2 text-danger"></i>Rentas Activas en Curso</h5>
    </div>
    <div class="card-body p-0">
      <div class="table-responsive">
        <table class="table table-sm table-hover align-middle mb-0">
          <thead class="table-light">
            <tr>
              <th>ID</th>
              <th>Equipo</th>
              <th>Cliente</th>
              <th>Fecha</th>
              <th>Hora Inicio</th>
              <th>Bono Mins</th>
              <th class="text-end">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {% for r in active_rents %}
              <tr>
                <td>#{{ r.id }}</td>
                <td><span class="fw-bold">{{ r.equipment ? r.equipment.name : 'Equipo #' ~ r.equipment_id }}</span></td>
                <td>{{ r.person_name }}</td>
                <td>{{ r.start_date }}</td>
                <td><span class="badge bg-secondary">{{ r.start_time }}</span></td>
                <td>{{ r.bonus_mins }} min</td>
                <td class="text-end">
                  <a href="{{ base_url }}/rents/finish/{{ r.id }}" class="btn btn-xs btn-danger">
                    <i class="bi bi-cash me-1"></i> Finalizar y Cobrar
                  </a>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </div>
  {% endif %}
</div>
{% endblock %}
