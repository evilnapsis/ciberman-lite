{% extends "layouts/main.html.twig" %}

{% block title %}Nuevo Equipo{% endblock %}

{% block content %}
<div class="container-fluid">
  <div class="row justify-content-center">
    <div class="col-lg-8">
      <div class="card shadow-sm">
        <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
          <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i>Registrar Nuevo Equipo</h5>
          <a href="{{ base_url }}/equipments" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Volver
          </a>
        </div>
        <div class="card-body">
          {% if errors is defined and errors is not empty %}
            <div class="alert alert-danger">
              <ul class="mb-0">
                {% for err in errors %}
                  <li>{{ err }}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          <form method="POST" action="{{ base_url }}/equipments/create">
            {{ csrf_field() }}

            <div class="row g-3">
              <div class="col-md-6">
                <label class="form-label fw-bold">Código o Número de Cabina</label>
                <input type="text" name="code" class="form-control" placeholder="Ej: PC-01, CABINA-02" value="{{ old.code|default('') }}">
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold">Nombre del Equipo *</label>
                <input type="text" name="name" class="form-control" required placeholder="Ej: Computadora 1, Gamer 3" value="{{ old.name|default('') }}">
              </div>

              <div class="col-12">
                <label class="form-label fw-bold">Descripción / Características</label>
                <textarea name="description" class="form-control" rows="2" placeholder="Ej: Windows 11, Core i5, 16GB RAM, Monitor 24">{{ old.description|default('') }}</textarea>
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold">Precio por Hora ($) *</label>
                <input type="number" step="0.5" name="price_hour" class="form-control" required value="{{ old.price_hour|default('15.00') }}">
              </div>

              <div class="col-md-6">
                <label class="form-label fw-bold">Precio por Media Hora ($) *</label>
                <input type="number" step="0.5" name="price_half" class="form-control" required value="{{ old.price_half|default('8.00') }}">
              </div>

              <div class="col-12 text-end mt-4">
                <a href="{{ base_url }}/equipments" class="btn btn-secondary me-2">Cancelar</a>
                <button type="submit" class="btn btn-primary px-4">
                  <i class="bi bi-save me-1"></i> Guardar Equipo
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
{% endblock %}
